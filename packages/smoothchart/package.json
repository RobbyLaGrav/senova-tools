{
  "name": "@senova/smoothchart",
  "version": "0.0.0",
  "description": "Tiny SVG charts with no dependencies: monotone smooth lines, per-line hover, animated data changes.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./styles.css": "./styles.css"
  },
  "files": ["dist", "styles.css", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -b",
    "example": "tsc -b && node examples/serve.ts"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": { "@types/react": "^19.0.0" },
  "keywords": ["chart", "svg", "line chart", "bar chart", "monotone", "react"],
  "repository": { "type": "git", "url": "https://github.com/RobbyLaGrav/senova-tools.git", "directory": "packages/smoothchart" },
  "engines": { "node": ">=24" }
}
