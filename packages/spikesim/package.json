{
  "name": "@senova/spikesim",
  "version": "0.0.0",
  "description": "Browser simulation of an event camera feeding leaky integrate-and-fire neurons, with a population-vector decoder and live operation counts.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "keywords": ["neuromorphic", "event camera", "spiking neural network", "leaky integrate-and-fire", "simulation", "teaching"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "example": "node examples/headless.ts",
    "example:browser": "node examples/serve.ts"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "repository": { "type": "git", "url": "https://github.com/RobbyLaGrav/senova-tools.git", "directory": "packages/spikesim" },
  "engines": { "node": ">=24" }
}
